{
  "name": "englobe-ams-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Englobe AMS — local TypeScript API over in-process PostgreSQL (PGlite). Proof of concept; no cloud services.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "reseed": "tsx src/main.ts --reseed --exit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "fastify": "5.12.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
