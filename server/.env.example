# server/ environment — copy to .env only if you need to override a default.
# Nothing here is a secret. CLAUDE.md rule 10 forbids credentials in source; the password below
# is a local container's development password that never reaches Azure or a browser bundle.
# Production credentials come from managed identity and Key Vault, never from a file.

# ---------------------------------------------------------------- database

# Which driver. "postgres" (default) talks to docker-compose.yml; "pglite" keeps the original
# in-process PostgreSQL-on-WASM, which needs no container but cannot prove concurrency.
AMS_DB=postgres

# Must match docker-compose.yml: user ams, password ams, database ams, host port 5433.
AMS_DATABASE_URL=postgres://ams:ams@127.0.0.1:5433/ams

# Pool size. The concurrency proof needs more than one client — that is the whole point of
# leaving PGlite behind. Default 10.
AMS_DB_POOL_MAX=10

# ---------------------------------------------------------------- environment

# Which environment this process believes it is. Falls back to NODE_ENV when unset, and to
# "development" when neither is set.
#
# This is the marker CLAUDE.md rule 12 turns on: "synthetic data is refused in production.
# Environment and seed markers are verified before any load." The refusal is enforced by the
# DATABASE, on the `meta` table (db/migrations/0007_environment_guard.sql), in both directions —
# loading synthetic data into a production environment, and promoting an environment that already
# holds synthetic data to production. Markers are written before rows, so a refused load leaves
# zero rows rather than a partial one.
#
# Setting this to "production" on a developer machine is a deliberate act and will refuse every
# synthetic profile. That is the intended behaviour, not a bug.
AMS_ENV=development

# ---------------------------------------------------------------- dataset

# A directory under migration/: "staged" (the 1,026 real migrated assets, default) or a
# synthetic profile such as "synthetic/demo", "synthetic/standard", "synthetic/large".
AMS_DATASET=staged

# PGlite only — where it persists. Ignored by the postgres driver, which has a database, not a
# directory. Default server/data/ (gitignored).
# AMS_DATA_DIR=

# ---------------------------------------------------------------- identity

# Which identity provider. "dev" (default) is the x-ams-dev-user header shortcut — identity, NOT
# authentication. It is refused outright when the environment is production. "oidc" is the real
# Microsoft Entra client in server/src/auth/providers/.
AMS_AUTH=dev

# Signs the session cookie. Any long random string locally; in Azure this comes from Key Vault via
# managed identity and never from a file (CLAUDE.md rule 10). A missing value is refused rather
# than defaulted, because a predictable signing key is worse than no session at all.
# AMS_SESSION_SECRET=

# How long a session lives. Default 480 (eight hours — one working day).
# AMS_SESSION_TTL_MINUTES=480

# ---- AMS_AUTH=oidc only. None of these exists yet: R6 (the Entra app registration owner) is an
# ---- Englobe IT dependency, recorded as assumption A-R6. The provider is fully implemented and
# ---- tested against a fabricated issuer; it fails with a clear message when unconfigured.

# The Entra tenant. The issuer is PINNED to it — a token from any other tenant is refused even if
# it is validly signed, which is what makes this tenant-scoped rather than "any Microsoft account".
# AMS_OIDC_TENANT_ID=
# AMS_OIDC_CLIENT_ID=
# AMS_OIDC_CLIENT_SECRET=
# AMS_OIDC_REDIRECT_URI=http://127.0.0.1:3001/api/auth/callback
# AMS_OIDC_AUTHORITY=https://login.microsoftonline.com
# AMS_OIDC_SCOPES=openid profile email
# AMS_OIDC_POST_LOGOUT_URI=

# ---------------------------------------------------------------- http

AMS_PORT=3001
AMS_HOST=127.0.0.1
