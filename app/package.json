{
  "name": "englobe-ams",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-state-machine.mjs && node scripts/copy-staged-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-state-machine.mjs && node scripts/copy-staged-data.mjs",
    "build": "tsc -b && vite build",
    "prebuild:release": "node scripts/release-guard.mjs && node scripts/generate-state-machine.mjs",
    "build:release": "tsc -b && vite build --mode release && node scripts/scan-bundle.mjs",
    "scan:bundle": "node scripts/scan-bundle.mjs",
    "preview": "vite preview",
    "pretest": "node scripts/generate-state-machine.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:state-machine": "node scripts/generate-state-machine.mjs",
    "copy:staged-data": "node scripts/copy-staged-data.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.7",
    "@fluentui/react-icons": "^2.0.339",
    "@microsoft/power-apps": "^1.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
